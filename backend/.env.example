# =============================================================================
# SignalForge — Local Development Environment Variables
# Copy to .env and fill in values as needed
# =============================================================================

# --- Database ----------------------------------------------------------------
SF_DATABASE_URL=postgresql+asyncpg://signalforge:signalforge@localhost:5432/signalforge

# --- Redis / Celery ----------------------------------------------------------
SF_REDIS_URL=redis://localhost:6379/0
SF_CELERY_BROKER_URL=redis://localhost:6379/1
SF_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Authentication ----------------------------------------------------------
SF_JWT_SECRET=change-me-in-production
SF_JWT_ALGORITHM=HS256
SF_JWT_EXPIRY_MINUTES=30
SF_JWT_REFRESH_EXPIRY_DAYS=7

# --- Encryption (broker credentials at rest) ---------------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SF_ENCRYPTION_KEY=

# --- App ---------------------------------------------------------------------
SF_APP_NAME=SignalForge
SF_DEBUG=true
SF_CORS_ORIGINS=["http://localhost:5173"]
SF_DEFAULT_EXCHANGE=binance

# --- AI Advisor --------------------------------------------------------------
SF_ANTHROPIC_API_KEY=
# Admin API key for Usage & Cost API (sk-ant-admin...)
SF_ANTHROPIC_ADMIN_API_KEY=
SF_AI_PREPAID_CREDIT_USD=0
SF_AI_MAX_DAILY_API_CALLS=500

# --- Admin -------------------------------------------------------------------
# UUID of admin user; leave empty for no admin restriction
SF_ADMIN_USER_ID=

# --- Email alerts (optional) -------------------------------------------------
SF_RESEND_API_KEY=
SF_RESEND_DOMAIN=signalforge.dev

# --- Monitoring (optional) ---------------------------------------------------
SF_SENTRY_DSN=
