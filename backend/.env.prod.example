# Copy to .env.prod and fill in real values

# Database
SF_DATABASE_URL=postgresql+asyncpg://signalforge:CHANGE_ME@timescaledb:5432/signalforge

# Redis
SF_REDIS_URL=redis://redis:6379/0
SF_CELERY_BROKER_URL=redis://redis:6379/1
SF_CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security — MUST CHANGE IN PRODUCTION
SF_JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET
SF_ENCRYPTION_KEY=CHANGE_ME_USE_python_-c_"from_cryptography.fernet_import_Fernet;print(Fernet.generate_key().decode())"

# AI + Email (optional)
SF_ANTHROPIC_API_KEY=
SF_RESEND_API_KEY=
SF_RESEND_DOMAIN=signalforge.dev

# App
SF_APP_NAME=SignalForgeAI
SF_DEBUG=False
SF_CORS_ORIGINS=["https://your-domain.com"]
