# Multi-stage production Dockerfile for SignalForge API
# Stage 1: Build dependencies (including ta-lib C library)
FROM python:3.12.8-slim AS builder

WORKDIR /build

# Install ta-lib C library (required by hmmlearn/numpy/pandas stack)
# TODO: Pin ta-lib version and verify checksum for supply chain security
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ make wget \
    && wget -q https://github.com/TA-Lib/ta-lib/releases/download/v0.6.4/ta-lib-0.6.4-src.tar.gz \
    && tar -xzf ta-lib-0.6.4-src.tar.gz \
    && cd ta-lib-0.6.4 \
    && ./configure --prefix=/usr \
    && make -j$(nproc) \
    && make install \
    && cd .. \
    && rm -rf ta-lib-0.6.4 ta-lib-0.6.4-src.tar.gz

COPY pyproject.toml .
RUN pip install --no-cache-dir --prefix=/install .

# Stage 2: Slim runtime image
FROM python:3.12.8-slim

WORKDIR /app

# Install ta-lib shared libraries (runtime only, no compiler)
COPY --from=builder /usr/lib/libta_lib* /usr/lib/
COPY --from=builder /usr/include/ta-lib/ /usr/include/ta-lib/
RUN ldconfig

# Copy installed Python packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY app/ app/
COPY alembic/ alembic/
COPY alembic.ini .

# Non-root user for security
RUN useradd -m -r appuser && chown -R appuser /app
USER appuser

EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
