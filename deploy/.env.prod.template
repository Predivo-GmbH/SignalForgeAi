# =============================================================================
# SignalForge — Production Environment Variables
# Copy to backend/.env.prod and fill in all values marked CHANGE-ME
# =============================================================================

# --- Database -----------------------------------------------------------------
SF_DATABASE_URL=postgresql+asyncpg://signalforge:CHANGE-ME-DB-PASSWORD@timescaledb:5432/signalforge
SF_DB_PASSWORD=CHANGE-ME-DB-PASSWORD

# --- Redis (internal Docker network, no auth needed) --------------------------
SF_REDIS_URL=redis://redis:6379/0
SF_CELERY_BROKER_URL=redis://redis:6379/1
SF_CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Authentication -----------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SF_JWT_SECRET=CHANGE-ME-JWT-SECRET
SF_JWT_ALGORITHM=HS256
SF_JWT_EXPIRY_MINUTES=30
SF_JWT_REFRESH_EXPIRY_DAYS=7

# --- Encryption (broker credentials at rest) ----------------------------------
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SF_ENCRYPTION_KEY=CHANGE-ME-FERNET-KEY

# --- App settings -------------------------------------------------------------
SF_APP_NAME=SignalForge
SF_DEBUG=false
# Set to your domain once you have one, e.g. ["https://signalforge.example.com"]
SF_CORS_ORIGINS=["http://YOUR_SERVER_IP:8000"]

# --- Broker APIs (fill in when ready for live trading) ------------------------
# SF_ALPACA_API_KEY=
# SF_ALPACA_API_SECRET=
# SF_ALPACA_PAPER=True

# --- AI Journal (optional) ----------------------------------------------------
# SF_ANTHROPIC_API_KEY=

# --- Email alerts (optional) --------------------------------------------------
