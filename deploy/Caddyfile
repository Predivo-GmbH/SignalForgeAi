# =============================================================================
# SignalForge — Caddy Reverse Proxy Configuration
#
# --- IP-only mode (no domain yet) ---
# Serves on http://<server-ip> without SSL.
# When you get a domain, replace :80 with your domain (e.g. signalforge.example.com)
# and Caddy will auto-provision Let's Encrypt SSL.
# =============================================================================

:80 {
    # API and WebSocket endpoints → FastAPI backend
    handle /api/* {
        reverse_proxy localhost:8000
    }
    handle /ws/* {
        reverse_proxy localhost:8000
    }
    handle /health {
        reverse_proxy localhost:8000
    }
    handle /docs {
        reverse_proxy localhost:8000
    }
    handle /openapi.json {
        reverse_proxy localhost:8000
    }

    # Everything else → frontend static files
    handle {
        root * /opt/signalforge/frontend/dist
        try_files {path} /index.html
        file_server
    }

    log {
        output file /var/log/caddy/signalforge.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# =============================================================================
# When you have a domain, replace the block above with:
#
# signalforge.example.com {
#     handle /api/* {
#         reverse_proxy localhost:8000
#     }
#     handle /ws/* {
#         reverse_proxy localhost:8000
#     }
#     handle /health {
#         reverse_proxy localhost:8000
#     }
#     handle {
#         root * /opt/signalforge/frontend/dist
#         try_files {path} /index.html
#         file_server
#     }
# }
# =============================================================================
