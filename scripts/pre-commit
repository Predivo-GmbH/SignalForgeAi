#!/bin/bash
# Pre-commit hook: blocks commit if builds or imports fail.

REPO_ROOT="$(git rev-parse --show-toplevel)"
FRONTEND_DIR="$REPO_ROOT/frontend"
BACKEND_DIR="$REPO_ROOT/backend"

# --- Frontend build check ---
STAGED_FRONTEND=$(git diff --cached --name-only -- frontend/)
if [ -n "$STAGED_FRONTEND" ]; then
  echo "==> Pre-commit: running frontend build..."
  cd "$FRONTEND_DIR" || exit 1

  npm run build 2>&1
  BUILD_EXIT=$?

  if [ $BUILD_EXIT -ne 0 ]; then
    echo ""
    echo "COMMIT BLOCKED: frontend build failed (tsc -b && vite build)"
    echo "Fix the errors above before committing."
    exit 1
  fi

  echo "==> Pre-commit: frontend build passed."
fi

# --- Backend import smoke test ---
STAGED_BACKEND=$(git diff --cached --name-only -- backend/)
if [ -n "$STAGED_BACKEND" ]; then
  echo "==> Pre-commit: running backend import smoke test..."
  cd "$BACKEND_DIR" || exit 1

  python -m pytest tests/test_import_smoke.py -q --tb=short 2>&1
  SMOKE_EXIT=$?

  if [ $SMOKE_EXIT -ne 0 ]; then
    echo ""
    echo "COMMIT BLOCKED: backend import smoke test failed"
    echo "A module has broken imports. Fix before committing."
    exit 1
  fi

  echo "==> Pre-commit: backend imports OK."
fi

exit 0
